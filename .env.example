# =============================================================================
# 环境变量模板 (.env.example)
# -----------------------------------------------------------------------------
# 用途：列出项目运行所需的全部环境变量，给出安全的示例或默认值。
# 【实际开发中，敏感信息（API Key、数据库密码）单独用文件私密保存，但更推荐用系统环境变量进行保存】
# 使用方法：将此文件复制为 .env，然后在 .env 中填入您的真实密钥和配置。
#         需要将 .env 写入 .gitignore，防止被提交到 Git。
# =============================================================================

# ==========================
# 1. 核心 AI 服务（必须配置）
# ==========================

# 阿里云百炼 DashScope 平台的 API Key
# 用于调用大语言模型 (LLM)、实时语音识别 (ASR) 和语音合成 (TTS) 接口
# 去这里创建并获取 Key：https://bailian.console.aliyun.com/
AI_BAILIAN_API_KEY=your_dashscope_api_key_here

# 在阿里云百炼平台中默认使用的大语言模型，可按需切换
AI_MODEL=qwen3.5-flash

# 用于加密存储各个 LLM Provider API Key 的主密钥 (AES-256-GCM)
# AES（高级加密标准），256（密钥长度，bit 位），GCM（伽罗瓦/计数器模式）
# 程序会把您填写的各种第三方 API Key 加密后再存库，读取时用这个密钥解密
# 部署后必须永久保持不变！一旦更换，之前加密过的所有 Key 都会无法解密
# 生成一个安全的密钥（Linux / macOS 命令）：openssl rand -base64 32
# windows 如果安装了 openssl 也可以直接使用，否则
# $keyBytes = New-Object byte[] 32;$rng = [System.Security.Cryptography.RNGCryptoServiceProvider]::Create();
# $rng.GetBytes($keyBytes);[System.Convert]::ToBase64String($keyBytes)
APP_AI_CONFIG_ENCRYPTION_KEY=change_me_provider_api_key_encryption_key

# ==========================
# 2. （可选）文字类 Provider（AI 大语言模型服务提供商）
# ==========================
# 下面这些提供商都兼容 OpenAI 接口格式。
# 只要填上对应的 API Key，系统就会自动注册该模型，之后可以在应用中选择使用。
# 不想用某个 Provider，直接将它的 API_KEY 留空即可，不会影响其他功能。

# LM Studio 本地推理服务（通常运行在您自己的电脑上，不需要真实 Key）
# 启用方法：去掉下面这一行的 # 注释（Key 可以随便填，比如 lm-studio）
# PROVIDER_LMSTUDIO_API_KEY=lm-studio

# Moonshot AI / Kimi
# 官网申请 Key：https://platform.moonshot.cn/
PROVIDER_KIMI_API_KEY=
PROVIDER_KIMI_MODEL=kimi-k2.6

# DeepSeek
# 官网申请 Key：https://platform.deepseek.com/
PROVIDER_DEEPSEEK_API_KEY=
PROVIDER_DEEPSEEK_MODEL=deepseek-v4-flash

# 智谱 AI / GLM
# 官网申请 Key：https://open.bigmodel.cn/
PROVIDER_GLM_API_KEY=
PROVIDER_GLM_MODEL=glm-5

# 如果您有其它兼容 OpenAI 接口的服务（比如自部署模型），可以照下面的格式添加：
# 1. 设置 API Key 变量，例如 PROVIDER_MYPROVIDER_API_KEY=your_key
# 2. 设置 MODEL 变量，例如 PROVIDER_MYMODEL_MODEL=your_model
# 3. 在 application.yml 中的 app.ai.providers 下配置 base-url 和模型映射

# ==========================
# 3. 数据库、缓存与存储（本地开发默认值，与 docker-compose 服务保持同步）
# ==========================
# 这些配置主要供 docker-compose 使用，也可以被 Spring Boot 应用通过 application.yml 引用。
# 正是因为该文件中有些变量被 docker-compose 使用，所以 .env 文件才必须要放在 docker-compose 文件同目录下，否则无法被识别

# PostgreSQL 数据库
POSTGRES_HOST=localhost          # 数据库的主机地址
POSTGRES_PORT=5432               # 端口号
POSTGRES_DB=interview_guide      # 使用的数据库名称
POSTGRES_USER=postgres           # 数据库用户名
POSTGRES_PASSWORD=password       # 数据库密码

# Redis 缓存
REDIS_HOST=localhost             # Redis 的主机地址
REDIS_PORT=6379                  # Redis 端口号

# 对象存储（兼容 S3 协议，这里用的是本地开发用的 RustFS）
APP_STORAGE_ENDPOINT=http://localhost:9000    # S3 服务地址（含协议和端口）
APP_STORAGE_ACCESS_KEY=rustfsadmin           # 访问密钥 ID（相当于用户名）
APP_STORAGE_SECRET_KEY=rustfsadmin           # 访问密钥密码
APP_STORAGE_BUCKET=interview-guide           # 存放文件的桶名称

# ==========================
# 4. 语音面试相关参数（所有选项均有默认值，不配置也能正常运行）
# ==========================

# 用户连续说话时，话语合并的去抖时间（单位：毫秒）
# 系统检测到用户停顿时会等待这么久，如果在这段时间内用户又继续说话，两段话就会被合并成一句。
# 数值越大，越不容易在句中切分，适合用户说话容易停顿的场景。
# 默认值通常已合适，不需要修改。
# APP_VOICE_USER_UTTERANCE_DEBOUNCE_MS=1600

# ASR（语音识别）的句间静音判断阈值（单位：毫秒）
# 当用户停顿超过这个时间，系统就认为一句话结束，开始处理。
# 数值越大，越不容易出现一句话被切成多段的情况；但过大可能会把两句话误合在一起。
# 默认值通常已合适，不需要修改。
# APP_VOICE_ASR_SILENCE_MS=1000

# 应用启动时是否自动预热“面试官开场白”的音频（提前调用 TTS 生成语音）
# 开启后会增加一点启动耗时，但首次面试时播放开场白会更快。
# 默认关闭（不预热），如需开启请把下面行的注释去掉并将值改为 true：
# APP_VOICE_OPENING_AUDIO_WARMUP_ENABLED=false